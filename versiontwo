        .sort((a,b) => b.composite_score - a.composite_score);
      const withMeta = candidates.map(p => ({ ...p, gradYear: inferGraduatingYear(p) }));
      state.filteredPlayers = applyPositionSort(withMeta).filter(p => !!findFirstSlotForPlayer(p));
    }

