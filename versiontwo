      if (totalPages > 1) {
        paginationEl.style.display = '';
        pageInfoEl.textContent = `Page ${state.page} of ${totalPages}`;
        prevPageBtn.disabled = state.page === 1;
        nextPageBtn.disabled = state.page === totalPages;
      } else {
        paginationEl.style.display = 'none';
      }
    }

    function updateRosterUI() {
      const slotEls = rosterGridEl.querySelectorAll('.slot');
      slotEls.forEach(el => {
        const id = el.dataset.slotId;
        const slot = ROSTER_SLOTS.find(s => s.id === id);
        const content = state.drafted[id];
        if (!content) {
          el.innerHTML = `
            <div class="slot-content">
              <div class="slot-label">${slot.label}</div>
              <div class="slot-empty">Empty</div>
            </div>
          `;
          el.style.backgroundColor = '';
          el.style.borderColor = '';
        } else {
          const logoSrc = SCHOOL_LOGOS[content.school];
          const logoImg = logoSrc ? `<img class="slot-logo" src="${logoSrc}" alt="${content.school} logo">` : '';
          el.innerHTML = `
            <div class="slot-content">
              <div class="slot-label">${slot.label}</div>
              <div class="slot-player-name">${content.name}</div>
              <div class="slot-player-meta">${content.position} · ${displaySchoolName(content.school)} · ${content.gradYear}</div>
            </div>
            ${logoImg}
          `;

          const colorInfo = SCHOOL_COLORS[content.school];
          if (colorInfo && colorInfo.usable) {
            el.style.backgroundColor = hexToRgba(colorInfo.tint, colorInfo.alpha != null ? colorInfo.alpha : 0.1);
            el.style.borderColor = '';
          } else {
            el.style.backgroundColor = '';
            el.style.borderColor = '';
          }
        }
      });

    }

    function draftPlayer(player, slot) {
      state.drafted[slot.id] = {
        player_position_id: player.player_position_id,
        name: player.name,
        school: player.school,
        position: player.position,
        gradYear: inferGraduatingYear(player),
        composite_score: player.composite_score,
        weighted_score: weightedScore(player),
      };
      state.usedIds.add(player.player_position_id);
      updateRosterUI();

      const totalSlots = ROSTER_SLOTS.length;
      const filledCount = Object.keys(state.drafted).length;

      if (filledCount === totalSlots) {
        computeRecord();
      } else {
        // After a pick, reset spin state so the next pick starts fresh
        resetSpinState();
      }
    }

    function computeRecord() {
      let total = 0;
      for (const slotId in state.drafted) {
        total += state.drafted[slotId].weighted_score || 0;
      }
      total = Math.round(total);

      let record, headline, description;

      if (total >= 520) {
        record = '13-0';
        headline = 'All-time great';
        description = 'You ran the table, winning every regular season game on the way to the state title.';
      } else if (total >= 460) {
        record = '12-1';
        headline = 'Memorable run';
        description = 'A run to the state championship your town will never forget.';
      } else if (total >= 410) {
        record = '11-2';
        headline = 'Just short';
        description = "Your team was among the best in the state but couldn't get over the hump.";
      } else if (total >= 360) {
        record = '10-3';
        headline = 'Something to build on';
        description = 'Your program is trending in the right direction.';
      } else if (total >= 320) {
        record = '9-4';
        headline = 'Solid playoff team';
        description = 'Nothing wrong with earning another week of practice.';
      } else if (total >= 290) {
        record = '7-3';
        headline = 'Tournament bubble';
        description = "Let's hope you scheduled up a class a few times.";
      } else if (total >= 250) {
        record = '6-4';
        headline = 'Not as easy as it looks';
        description = 'When can we start to think about next year?';
      } else if (total >= 230) {
        record = '5-5';
        headline = 'Mediocre middle';
        description = "Sometimes the oblong-shaped ball bounces your way. Sometimes it doesn't.";
      } else if (total >= 200) {
        record = '4-6';
        headline = 'Something has to change';
        description = 'Is it time to hand over play-calling duties?';
      } else {
        record = '3-7';
        headline = 'Tough luck';
        description = "Maybe it's time to ask to shift down a class.";
      }

      state.record = { record, headline, description, total };

      recordValueEl.textContent = record;
      recordHeadlineEl.textContent = headline;
      recordDescriptionEl.textContent = description;

      recordValueEl.classList.remove('good','bad');
      if (record === '13-0' || record === '12-1' || record === '11-2') {
        recordValueEl.classList.add('good');
      } else if (record === '3-7') {
        recordValueEl.classList.add('bad');
      }

      draftPanelTitleEl.textContent = 'Your Record';
      spinBoxEl.style.display = 'none';
      playersListEl.style.display = 'none';
      paginationEl.style.display = 'none';
      recordDisplay.style.display = '';
    }

    const shareBtn = document.getElementById('share-btn');
    const shareCanvas = document.getElementById('share-canvas');
    const shareLogoImg = document.getElementById('share-logo-img');

    function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
      const words = text.split(' ');
      let line = '';
      let lines = [];
      for (let i = 0; i < words.length; i++) {
        const testLine = line + words[i] + ' ';
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxWidth && i > 0) {
          lines.push(line.trim());
          line = words[i] + ' ';
        } else {
          line = testLine;
        }
      }
      lines.push(line.trim());
      lines.forEach((l, idx) => ctx.fillText(l, x, y + idx * lineHeight));
      return lines.length * lineHeight;
    }

    function buildShareCard() {
      const ctx = shareCanvas.getContext('2d');
      const W = shareCanvas.width;
      const H = shareCanvas.height;

      const gradient = ctx.createLinearGradient(0, 0, W, H);
      gradient.addColorStop(0, '#1569b3');
      gradient.addColorStop(1, '#0d2c4a');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, W, H);

      ctx.textAlign = 'center';

      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = '600 30px Inter, Arial, sans-serif';
      ctx.fillText('CAN YOU GO 13-0?', W / 2, 90);

      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      ctx.font = '400 24px Inter, Arial, sans-serif';
      const dateStr = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      ctx.fillText('Draft the best Delaware high school football team \u00b7 ' + dateStr, W / 2, 130);

      ctx.fillStyle = '#ffffff';
      ctx.font = '800 150px Inter, Arial, sans-serif';
      ctx.fillText(state.record.record, W / 2, 300);

      ctx.font = '700 42px Inter, Arial, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(state.record.headline, W / 2, 360);

      ctx.font = '400 26px Inter, Arial, sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      wrapText(ctx, state.record.description, W / 2, 410, W - 160, 32);

      ctx.textAlign = 'left';
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = '600 30px Inter, Arial, sans-serif';
      ctx.fillText('YOUR ROSTER', 80, 520);

      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(80, 540);
      ctx.lineTo(W - 80, 540);
      ctx.stroke();

      const entries = ROSTER_SLOTS.map(slot => ({ slot, player: state.drafted[slot.id] })).filter(e => e.player);

      const colWidth = (W - 160) / 2;
      const rowHeight = 92;
      const startY = 590;

      entries.forEach((entry, i) => {
        const col = i % 2;
        const row = Math.floor(i / 2);
        const x = 80 + col * colWidth;
        const y = startY + row * rowHeight;

        const isFlex = !!entry.slot.isFlex;
        const posLabel = displayPosition(entry.player.position);
        const circleLabel = isFlex ? 'FLEX' : posLabel;
        const schoolLabel = displaySchoolName(entry.player.school);
        const subLine = isFlex
          ? (posLabel + ' \u00b7 ' + schoolLabel)
          : schoolLabel;

        ctx.beginPath();
        ctx.fillStyle = 'rgba(255,255,255,0.12)';
        ctx.arc(x + 26, y + 8, 26, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.font = '700 16px Inter, Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(circleLabel, x + 26, y + 14);
        ctx.textAlign = 'left';

        ctx.fillStyle = '#ffffff';
        ctx.font = '600 26px Inter, Arial, sans-serif';
        ctx.fillText(entry.player.name, x + 66, y + 4);

        ctx.fillStyle = 'rgba(255,255,255,0.7)';
        ctx.font = '400 20px Inter, Arial, sans-serif';
        ctx.fillText(subLine, x + 66, y + 32);
      });

      ctx.textAlign = 'center';
      if (shareLogoImg && shareLogoImg.complete && shareLogoImg.naturalWidth > 0) {
        const logoH = 100;
        const logoW = shareLogoImg.naturalWidth * (logoH / shareLogoImg.naturalHeight);
        ctx.drawImage(shareLogoImg, (W - logoW) / 2, H - 130, logoW, logoH);
      } else {
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.font = '400 24px Inter, Arial, sans-serif';
        ctx.fillText('delawareonline.com/13-0', W / 2, H - 50);
      }
    }

    const STORY_URL = 'https://www.delawareonline.com/story/sports/high-school/2026/08/11/draft-the-best-delaware-high-school-football-team-can-you-go-13-0/91064843007/';

    const shareMenuOverlay = document.getElementById('share-menu-overlay');
    const shareMenuClose = document.getElementById('share-menu-close');
    const shareMenuPreview = document.getElementById('share-menu-preview');
    const shareNativeBtn = document.getElementById('share-native-btn');
    const shareXBtn = document.getElementById('share-x-btn');
    const shareFacebookBtn = document.getElementById('share-facebook-btn');
    const shareDownloadBtn = document.getElementById('share-download-btn');

    let currentShareBlob = null;
    let currentShareBlobUrl = null;

    function shareCaption() {
      return 'I drafted a Delaware HS football team and went ' + state.record.record + '. Can you beat it?';
    }

    function openShareMenu() {
      buildShareCard();

      shareCanvas.toBlob((blob) => {
        currentShareBlob = blob;
        if (currentShareBlobUrl) URL.revokeObjectURL(currentShareBlobUrl);
        currentShareBlobUrl = URL.createObjectURL(blob);
        shareMenuPreview.src = currentShareBlobUrl;

        const file = new File([blob], '13-0-my-team.png', { type: 'image/png' });
        const nativeAvailable = !!(navigator.canShare && navigator.canShare({ files: [file] }));

        if (nativeAvailable) {
          shareNativeBtn.style.display = '';
          shareXBtn.style.display = 'none';
          shareFacebookBtn.style.display = 'none';
        } else {
          shareNativeBtn.style.display = 'none';
          shareXBtn.style.display = '';
          shareFacebookBtn.style.display = '';
        }

        shareMenuOverlay.style.display = 'flex';
      }, 'image/png');
    }

    function closeShareMenu() {
      shareMenuOverlay.style.display = 'none';
    }

    function downloadShareImage() {
      if (!currentShareBlobUrl) return;
      const a = document.createElement('a');
      a.href = currentShareBlobUrl;
      a.download = '13-0-my-team.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    shareBtn.addEventListener('click', openShareMenu);
    shareMenuClose.addEventListener('click', closeShareMenu);
    shareMenuOverlay.addEventListener('click', (e) => {
      if (e.target === shareMenuOverlay) closeShareMenu();
    });

    shareNativeBtn.addEventListener('click', async () => {
      if (!currentShareBlob) return;
      const file = new File([currentShareBlob], '13-0-my-team.png', { type: 'image/png' });
      try {
        await navigator.share({
          files: [file],
          title: 'Can you go 13-0?',
          text: shareCaption(),
          url: STORY_URL,
        });
        closeShareMenu();
      } catch (err) {
        // User cancelled or share failed; keep menu open
      }
    });

    shareXBtn.addEventListener('click', () => {
      downloadShareImage();
      const text = encodeURIComponent(shareCaption());
      const url = encodeURIComponent(STORY_URL);
      const intentUrl = 'https://twitter.com/intent/tweet?text=' + text + '&url=' + url;
      window.open(intentUrl, '_blank', 'noopener');
    });

    shareFacebookBtn.addEventListener('click', () => {
      downloadShareImage();
      const quote = encodeURIComponent(shareCaption());
      const url = encodeURIComponent(STORY_URL);
      const intentUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + url + '&quote=' + quote;
      window.open(intentUrl, '_blank', 'noopener');
    });

    shareDownloadBtn.addEventListener('click', () => {
      downloadShareImage();
    });

    spinBtn.addEventListener('click', () => {
      spinForSchool();
    });

    prevPageBtn.addEventListener('click', () => {
      if (state.page > 1) {
        state.page--;
        renderPlayers();
      }
    });

    nextPageBtn.addEventListener('click', () => {
      const totalPages = Math.ceil(state.filteredPlayers.length / state.perPage);
      if (state.page < totalPages) {
        state.page++;
        renderPlayers();
      }
    });


    const howModalOverlay = document.getElementById('how-modal-overlay');
    const howModalClose = document.getElementById('how-modal-close');

    document.getElementById('how-link').addEventListener('click', () => {
      howModalOverlay.style.display = 'flex';
    });

    howModalClose.addEventListener('click', () => {
      howModalOverlay.style.display = 'none';
    });

    howModalOverlay.addEventListener('click', (e) => {
      if (e.target === howModalOverlay) {
        howModalOverlay.style.display = 'none';
      }
    });

    initRoster();
    resetSpinState();
  </script>
</body>
</html>
