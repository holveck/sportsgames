    function spinForSchool() {
      // If we already have a school and no respins left, block further spins
      if (state.currentSchool && state.respinsRemaining <= 0) {
        schoolDisplay.textContent = `${state.currentSchool} (No respins left — draft from this school)`;
        return;
      }

      const schools = schoolsWithEligiblePlayers();
      if (!schools.length) {
        schoolDisplay.textContent = 'No eligible schools left — roster may be full.';
        return;
      }
      const randomSchool = schools[Math.floor(Math.random() * schools.length)];
      const isRespin = !!state.currentSchool;

      state.currentSchool = randomSchool;
      renderSchoolDisplay(randomSchool);
      state.page = 1;
      filterPlayersForCurrentSchool();

      // Every school returned here is guaranteed to have at least one eligible player
      // Initial spin for this pick is free; subsequent spins consume global respins
      if (isRespin) {
        state.respinsRemaining = Math.max(0, state.respinsRemaining - 1);
        state.spinsThisPick += 1;
      } else {
        state.spinsThisPick = 1;
