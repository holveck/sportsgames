    function getOpenSlotsForPlayer(player) {
      const pos = player.position;
      const openPrimaries = [];
      let flexSlot = null;

      for (const slot of ROSTER_SLOTS) {
        if (state.drafted[slot.id]) continue;
        const eligible = slot.positions.includes(pos);
        if (!eligible) continue;
        if (slot.isFlex) {
          if (!flexSlot) flexSlot = slot;
        } else {
          openPrimaries.push(slot);
        }
      }

      if (openPrimaries.length > 0) return openPrimaries;
      return flexSlot ? [flexSlot] : [];
    }

    function findFirstSlotForPlayer(player) {
      const eligible = getOpenSlotsForPlayer(player);
      return eligible.length ? eligible[0] : null;
    }

    function schoolsWithEligiblePlayers() {
      const remaining = PLAYERS.filter(p => !state.usedIds.has(p.player_position_id));
      const eligiblePlayers = remaining.filter(p => getOpenSlotsForPlayer(p).length > 0);
      return Array.from(new Set(eligiblePlayers.map(p => p.school)));
    }

    function hexToRgba(hex, alpha) {
      const h = hex.replace('#', '');
      const r = parseInt(h.substring(0, 2), 16);
      const g = parseInt(h.substring(2, 4), 16);
      const b = parseInt(h.substring(4, 6), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
