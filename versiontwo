    function inferGraduatingYear(player) {
      if (!player.seasons_recognized || !player.seasons_recognized.length) return '';
      const latestSeason = Math.max.apply(null, player.seasons_recognized);
      const grade = player.latest_grade || '';
      if (grade === 'sr.' || grade === 'SR') return String(latestSeason);
      if (grade === 'jr.' || grade === 'JR') return String(latestSeason + 1);
      if (grade === 'so.' || grade === 'SO') return String(latestSeason + 2);
      if (grade === 'fr.' || grade === 'FR') return String(latestSeason + 3);
      return String(latestSeason);
    }

    function applyPositionSort(players) {
      const val = positionSortEl.value;
      if (val === 'ALL') return players;
      return players.filter(p => {
        const pos = p.position;
        if (val === 'QB') return pos === 'QB';
        if (val === 'RB') return pos === 'RB' || pos === 'FB';
        if (val === 'WR') return pos === 'WR';
        if (val === 'TE') return pos === 'TE';
        if (val === 'OL') return pos === 'OL' || pos === 'C' || pos === 'G' || pos === 'OT';
        if (val === 'DL') return pos === 'DE' || pos === 'DT';
        if (val === 'LB') return pos === 'LB';
        if (val === 'DB') return pos === 'DB';
        if (val === 'KP') return pos === 'K' || pos === 'P';
        return true;
      });
    }

