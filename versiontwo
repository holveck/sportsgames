<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>13-0 Delaware Football Draft</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f5f5f5;
      --surface: #ffffff;
      --border-subtle: #d2d6dc;
      --primary: #1569b3;
      --primary-soft: rgba(21, 105, 179, 0.08);
      --primary-strong: rgba(21, 105, 179, 0.16);
      --text-main: #111827;
      --text-muted: #6b7280;
      --danger: #b91c1c;
      --success: #047857;
      --radius-lg: 12px;
      --shadow-soft: 0 10px 30px rgba(15, 23, 42, 0.10);
    }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
    }

    .embed {
      max-width: 1000px;
      margin: 0 auto;
      padding: 16px;
      box-sizing: border-box;
    }

    .card {
      background: var(--surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
      padding: 16px 20px 20px;
      box-sizing: border-box;
    }

    .header {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 16px;
    }

    .title {
      font-size: 1.4rem;
      font-weight: 700;
    }

    .subtitle {
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .how-link {
      font-size: 0.85rem;
      color: var(--primary);
      cursor: pointer;
      text-decoration: underline;
      align-self: flex-start;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
      gap: 16px;
    }

    @media (max-width: 768px) {
      .layout {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .panel {
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-subtle);
      padding: 12px;
      box-sizing: border-box;
    }

    .panel-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .spin-box {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 12px;
    }

    button {
      font-family: inherit;
      font-size: 0.95rem;
      border-radius: 999px;
      padding: 8px 16px;
      border: none;
      cursor: pointer;
      transition: background-color 0.15s ease, transform 0.05s ease;
    }

    button.primary {
      background: var(--primary);
      color: #fff;
    }

    button.primary:disabled {
      opacity: 0.45;
      cursor: default;
    }

    button.secondary {
      background: var(--primary-soft);
      color: var(--primary);
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .school-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .school-display {
      flex: 1;
      min-height: 60px;
      border-radius: var(--radius-lg);
      border: 1px dashed var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 1.05rem;
      background: #f9fafb;
      text-align: center;
      padding: 6px 8px;
    }

    .spins-left {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .spin-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    .sort-container {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: #f9fafb;
      border-radius: 999px;
      padding: 2px 8px;
    }

    .sort-select {
      font-size: 0.75rem;
      padding: 2px 6px;
      border-radius: 999px;
      border: none;
      background: transparent;
      color: var(--text-muted);
    }

    .players-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 320px;
      overflow-y: auto;
      margin-bottom: 8px;
    }

    .player-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      font-size: 0.9rem;
    }

    .player-main {
      display: flex;
      flex-direction: column;
    }

    .player-name {
      font-weight: 500;
    }

    .player-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .fills-tag {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .player-row button {
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 999px;
    }

    .player-row.disabled {
      opacity: 0.5;
    }

    .pagination {
      display: flex;
      justify-content: flex-end;
      gap: 6px;
      font-size: 0.8rem;
      align-items: center;
      color: var(--text-muted);
    }

    .pagination button {
      padding: 4px 10px;
    }

    .roster-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      font-size: 0.85rem;
    }

    @media (max-width: 480px) {
      .roster-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .slot {
      border-radius: 8px;
      border: 1px dashed var(--border-subtle);
      padding: 6px 8px;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .slot-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .slot-empty {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .slot-player-name {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .slot-player-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .footer {
      margin-top: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .record-pill {
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 0.85rem;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .record-pill.good {
      background: rgba(4, 120, 87, 0.1);
      color: var(--success);
    }

    .record-pill.bad {
      background: rgba(185, 28, 28, 0.08);
      color: var(--danger);
    }

    .record-display {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 28px 12px;
      min-height: 220px;
    }

    .record-value {
      font-size: 3rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.1;
    }

    .record-value.good {
      color: var(--success);
    }

    .record-value.bad {
      color: var(--danger);
    }

    .record-headline {
      font-size: 1.05rem;
      font-weight: 600;
      margin-top: 6px;
      color: var(--text);
    }

    .record-description {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 8px;
      max-width: 320px;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 16px;
    }

    .modal-box {
      background: #ffffff;
      border-radius: 14px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      padding: 20px;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .modal-title {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text);
    }

    .modal-close {
      background: none;
      border: none;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      color: var(--text-muted);
      padding: 0 4px;
    }

    .modal-list {
      margin: 0;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .modal-list li {
      font-size: 0.9rem;
      color: var(--text);
      line-height: 1.4;
    }

    .share-btn {
      margin-top: 18px;
      padding: 10px 20px;
      border-radius: 999px;
      border: none;
      background: #1569b3;
      color: #ffffff;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .share-btn:hover {
      background: #115a96;
    }

    .share-canvas {
      display: none;
    }

    .share-menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1100;
      padding: 16px;
    }

    .share-menu-box {
      background: #ffffff;
      border-radius: 14px;
      max-width: 360px;
      width: 100%;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      padding: 20px;
    }

    .share-menu-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .share-menu-title {
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--text);
    }

    .share-menu-close {
      background: none;
      border: none;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      color: var(--text-muted);
      padding: 0 4px;
    }

    .share-menu-preview {
      width: 100%;
      border-radius: 10px;
      margin-bottom: 14px;
      display: block;
    }

    .share-menu-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .share-menu-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 11px 14px;
      border-radius: 10px;
      border: 1px solid rgba(0,0,0,0.08);
      background: #f8fafc;
      color: var(--text);
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      text-align: left;
    }

    .share-menu-btn:hover {
      background: #eef2f7;
    }

    .share-menu-btn .icon {
      font-size: 1.1rem;
      width: 22px;
      text-align: center;
    }

    .slot {
      position: relative;
    }

    .slot-content {
      padding-right: 46px;
    }

    .slot-logo {
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      object-fit: contain;
    }

    .school-display-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
    }

    .school-display-logo {
      width: 32px;
      height: 32px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .slot {
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
  </style>
</head>
